{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*.e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^db/(.*)$": "<rootDir>/db/$1"
  },
  "setupFiles": [
    "<rootDir>/test/e2e-setup.ts"
  ],
  "modulePathIgnorePatterns": ["<rootDir>/dist"]
}
